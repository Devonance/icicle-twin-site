  "lines": [
    "\t\tmac0: ethernet@20110000 {",
    "\t\t\tcompatible = \"microchip,mpfs-macb\", \"cdns,macb\";",
    "\t\t\treg = <0x0 0x20110000 0x0 0x2000>;",
    "\t\t\t#address-cells = <1>;",
    "\t\t\t#size-cells = <0>;",
    "\t\t\tinterrupt-parent = <&plic>;",
    "\t\t\tinterrupts = <64>, <65>, <66>, <67>, <68>, <69>;",
    "\t\t\tlocal-mac-address = [00 00 00 00 00 00];",
    "\t\t\tclocks = <&clkcfg CLK_MAC0>, <&clkcfg CLK_AHB>, <&refclk>;",
    "\t\t\tclock-names = \"pclk\", \"hclk\", \"tsu_clk\";",
    "\t\t\tresets = <&mss_top_sysreg CLK_MAC0>;",
    "\t\t\tstatus = \"disabled\";",
    "\t\t};",
    "",
    "\t\tmac1: ethernet@20112000 {",
    "\t\t\tcompatible = \"microchip,mpfs-macb\", \"cdns,macb\";",
    "\t\t\treg = <0x0 0x20112000 0x0 0x2000>;",
    "\t\t\t#address-cells = <1>;",
    "\t\t\t#size-cells = <0>;",
