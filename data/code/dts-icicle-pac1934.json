  "note": "Four 10 mOhm shunts: VDDREG, VDDA25, VDD25, VDDA_REG.",
  "highlights": [],
  "lines": [
    "&i2c1 {",
    "\tstatus = \"okay\";",
    "",
    "\tpower-monitor@10 {",
    "\t\tcompatible = \"microchip,pac1934\";",
    "\t\treg = <0x10>;",
    "",
    "\t\t#address-cells = <1>;",
    "\t\t#size-cells = <0>;",
    "",
    "\t\tchannel@1 {",
    "\t\t\treg = <0x1>;",
    "\t\t\tshunt-resistor-micro-ohms = <10000>;",
    "\t\t\tlabel = \"VDDREG\";",
    "\t\t};",
    "",
    "\t\tchannel@2 {",
    "\t\t\treg = <0x2>;",
    "\t\t\tshunt-resistor-micro-ohms = <10000>;",
    "\t\t\tlabel = \"VDDA25\";",
    "\t\t};",
    "",
    "\t\tchannel@3 {",
    "\t\t\treg = <0x3>;",
    "\t\t\tshunt-resistor-micro-ohms = <10000>;",
    "\t\t\tlabel = \"VDD25\";",
    "\t\t};",
    "",
    "\t\tchannel@4 {",
    "\t\t\treg = <0x4>;",
    "\t\t\tshunt-resistor-micro-ohms = <10000>;",
    "\t\t\tlabel = \"VDDA_REG\";",
    "\t\t};",
    "\t};",
    "};"
  ],
