  "lines": [
    "\tleds {",
    "\t\tcompatible = \"gpio-leds\";",
    "",
    "\t\tled-1 {",
    "\t\t\tgpios = <&gpio2 16 GPIO_ACTIVE_HIGH>;",
    "\t\t\tcolor = <LED_COLOR_ID_RED>;",
    "\t\t\tlabel = \"led1\";",
    "\t\t};",
    "",
    "\t\tled-2 {",
    "\t\t\tgpios = <&gpio2 17 GPIO_ACTIVE_HIGH>;",
    "\t\t\tcolor = <LED_COLOR_ID_RED>;",
    "\t\t\tlabel = \"led2\";",
    "\t\t};",
    "",
    "\t\tled-3 {",
    "\t\t\tgpios = <&gpio2 18 GPIO_ACTIVE_HIGH>;",
    "\t\t\tcolor = <LED_COLOR_ID_AMBER>;",
    "\t\t\tlabel = \"led3\";",
    "\t\t};",
    "",
    "\t\tled-4 {",
    "\t\t\tgpios = <&gpio2 19 GPIO_ACTIVE_HIGH>;",
    "\t\t\tcolor = <LED_COLOR_ID_AMBER>;",
    "\t\t\tlabel = \"led4\";",
    "\t\t};",
    "\t};"
