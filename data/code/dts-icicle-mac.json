  "note": "Both PHYs are on mac1's MDIO bus: phy1 at address 9 (eth0), phy0 at 8. Both are ports of U4 VSC8662.",
  "highlights": [],
  "lines": [
    "&mac0 {",
    "\tphy-mode = \"sgmii\";",
    "\tphy-handle = <&phy0>;",
    "\tstatus = \"okay\";",
    "};",
    "",
    "&mac1 {",
    "\tphy-mode = \"sgmii\";",
    "\tphy-handle = <&phy1>;",
    "\tstatus = \"okay\";",
    "",
    "\tphy1: ethernet-phy@9 {",
    "\t\treg = <9>;",
    "\t};",
    "",
    "\tphy0: ethernet-phy@8 {",
    "\t\treg = <8>;",
    "\t};",
    "};"
  ],
