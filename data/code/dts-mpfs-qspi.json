  "lines": [
    "\t\tqspi: spi@21000000 {",
    "\t\t\tcompatible = \"microchip,mpfs-qspi\", \"microchip,coreqspi-rtl-v2\";",
    "\t\t\t#address-cells = <1>;",
    "\t\t\t#size-cells = <0>;",
    "\t\t\treg = <0x0 0x21000000 0x0 0x1000>;",
    "\t\t\tinterrupt-parent = <&plic>;",
    "\t\t\tinterrupts = <85>;",
    "\t\t\tclocks = <&clkcfg CLK_QSPI>;",
    "\t\t\tstatus = \"disabled\";",
    "\t\t};"
