  "lines": [
    "\t\tmmuart0: serial@20000000 {",
    "\t\t\tcompatible = \"ns16550a\";",
    "\t\t\treg = <0x0 0x20000000 0x0 0x400>;",
    "\t\t\treg-io-width = <4>;",
    "\t\t\treg-shift = <2>;",
    "\t\t\tinterrupt-parent = <&plic>;",
    "\t\t\tinterrupts = <90>;",
    "\t\t\tcurrent-speed = <115200>;",
    "\t\t\tclocks = <&clkcfg CLK_MMUART0>;",
    "\t\t\tstatus = \"disabled\"; /* Reserved for the HSS */",
    "\t\t};",
    "",
    "\t\tmmuart1: serial@20100000 {",
    "\t\t\tcompatible = \"ns16550a\";",
    "\t\t\treg = <0x0 0x20100000 0x0 0x400>;",
    "\t\t\treg-io-width = <4>;",
    "\t\t\treg-shift = <2>;",
    "\t\t\tinterrupt-parent = <&plic>;",
    "\t\t\tinterrupts = <91>;",
    "\t\t\tcurrent-speed = <115200>;",
    "\t\t\tclocks = <&clkcfg CLK_MMUART1>;",
    "\t\t\tstatus = \"disabled\";",
    "\t\t};"
