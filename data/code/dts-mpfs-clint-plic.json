  "lines": [
    "\t\tclint: clint@2000000 {",
    "\t\t\tcompatible = \"sifive,fu540-c000-clint\", \"sifive,clint0\";",
    "\t\t\treg = <0x0 0x2000000 0x0 0xC000>;",
    "\t\t\tinterrupts-extended = <&cpu0_intc 3>, <&cpu0_intc 7>,",
    "\t\t\t\t\t      <&cpu1_intc 3>, <&cpu1_intc 7>,",
    "\t\t\t\t\t      <&cpu2_intc 3>, <&cpu2_intc 7>,",
    "\t\t\t\t\t      <&cpu3_intc 3>, <&cpu3_intc 7>,",
    "\t\t\t\t\t      <&cpu4_intc 3>, <&cpu4_intc 7>;",
    "\t\t};",
    "",
    "\t\tplic: interrupt-controller@c000000 {",
    "\t\t\tcompatible = \"sifive,fu540-c000-plic\", \"sifive,plic-1.0.0\";",
    "\t\t\treg = <0x0 0xc000000 0x0 0x4000000>;",
    "\t\t\t#address-cells = <0>;",
    "\t\t\t#interrupt-cells = <1>;",
    "\t\t\tinterrupt-controller;",
    "\t\t\tinterrupts-extended = <&cpu0_intc 11>,",
    "\t\t\t\t\t      <&cpu1_intc 11>, <&cpu1_intc 9>,",
    "\t\t\t\t\t      <&cpu2_intc 11>, <&cpu2_intc 9>,",
    "\t\t\t\t\t      <&cpu3_intc 11>, <&cpu3_intc 9>,",
    "\t\t\t\t\t      <&cpu4_intc 11>, <&cpu4_intc 9>;",
    "\t\t\triscv,ndev = <186>;",
    "\t\t};"
  ],
