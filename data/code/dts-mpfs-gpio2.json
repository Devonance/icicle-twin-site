  "lines": [
    "\t\tgpio2: gpio@20122000 {",
    "\t\t\tcompatible = \"microchip,mpfs-gpio\";",
    "\t\t\treg = <0x0 0x20122000 0x0 0x1000>;",
    "\t\t\tinterrupt-parent = <&irqmux>;",
    "\t\t\tinterrupt-controller;",
    "\t\t\t#interrupt-cells = <2>;",
    "\t\t\tinterrupts = <64>, <65>, <66>, <67>,",
    "\t\t\t\t     <68>, <69>, <70>, <71>,",
    "\t\t\t\t     <72>, <73>, <74>, <75>,",
    "\t\t\t\t     <76>, <77>, <78>, <79>,",
    "\t\t\t\t     <80>, <81>, <82>, <83>,",
    "\t\t\t\t     <84>, <85>, <86>, <87>,",
    "\t\t\t\t     <88>, <89>, <90>, <91>,",
    "\t\t\t\t     <92>, <93>, <94>, <95>;",
    "\t\t\tclocks = <&clkcfg CLK_GPIO2>;",
    "\t\t\tgpio-controller;",
    "\t\t\t#gpio-cells = <2>;",
    "\t\t\tngpios = <32>;",
    "\t\t\tstatus = \"disabled\";",
    "\t\t};"
  ],
