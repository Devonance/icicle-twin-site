  "lines": [
    "\t\tusb: usb@20201000 {",
    "\t\t\tcompatible = \"microchip,mpfs-musb\";",
    "\t\t\treg = <0x0 0x20201000 0x0 0x1000>;",
    "\t\t\tinterrupt-parent = <&plic>;",
    "\t\t\tinterrupts = <86>, <87>;",
    "\t\t\tclocks = <&clkcfg CLK_USB>;",
    "\t\t\tinterrupt-names = \"dma\",\"mc\";",
    "\t\t\tstatus = \"disabled\";",
    "\t\t};"
