    "    l2lim (rwx)        : ORIGIN = 0x08000000, LENGTH = 512k",
    "    l2zerodevice (rwx) : ORIGIN = 0x0A000000, LENGTH = 512k",
    "    ddr (rwx)          : ORIGIN = 0x80000000, LENGTH = 32m",
