  "lines": [
    "\t\tmmc: mmc@20008000 {",
    "\t\t\tcompatible = \"microchip,mpfs-sd4hc\", \"cdns,sd4hc\";",
    "\t\t\treg = <0x0 0x20008000 0x0 0x1000>;",
    "\t\t\tinterrupt-parent = <&plic>;",
    "\t\t\tinterrupts = <88>;",
    "\t\t\tclocks = <&clkcfg CLK_MMC>;",
    "\t\t\tmax-frequency = <200000000>;",
    "\t\t\tstatus = \"disabled\";",
    "\t\t};"
